<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>51ce7cce-f23c-443a-ad92-b9a7a6f6d868</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="9.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kiberaz.Application\Kiberaz.Application.csproj" />
    <ProjectReference Include="..\Kiberaz.Infrastructure\Kiberaz.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Quiz seed faylları repo kökündədir (layihə qovluğundan kənarda).
       Bu olmadan `dotnet publish` onları kopyalamır və serverdə QuizSeeder heç nə tapmır —
       nəticədə production bazası 0 sualla açılır.
       LinkBase sayəsində fayllar çıxışda `seed-data/` altına düşür və
       QuizSeeder.FindSeedDataPath() onları BaseDirectory-də ilk addımda tapır. -->
  <ItemGroup>
    <Content Include="..\seed-data\*.json"
             LinkBase="seed-data"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
