{
  // ─────────────────────────────────────────────────────────────
  // PRODUCTION KONFİQURASİYASI
  // Bu fayl repo-ya commit olunur — burada HEÇ BİR GİZLİ AÇAR OLMAMALIDIR.
  // Secret-lər environment variable ilə verilir (iç-içə açarlar üçün "__"):
  //   JwtSettings__SecretKey, Captcha__SecretKey,
  //   EmailSettings__SmtpUsername, EmailSettings__SmtpPassword,
  //   Authentication__Google__ClientId, Authentication__Google__ClientSecret
  // ─────────────────────────────────────────────────────────────

  "ConnectionStrings": {
    // Publish çıxışı düz strukturdur — development-dəki "../Kiberaz.Infrastructure/Data/..."
    // yolu serverdə MÖVCUD DEYİL. Baza tətbiqin yanındakı App_Data qovluğunda saxlanılır.
    //
    // ⚠️ App_Data qovluğu publish qovluğunun İÇİNDƏ olmamalıdır — redeploy zamanı silinər.
    // Serverdə mütləq qovluqdan kənara yönləndir (env var ilə), məsələn:
    //   ConnectionStrings__LiteDb="Filename=/var/kiberaz/data/Kiberaz.db;Connection=shared"
    "LiteDb": "Filename=./App_Data/Kiberaz.db;Connection=shared"
  },

  "ForwardedHeaders": {
    // Proxy AYRI maşındadırsa (Cloudflare, xarici load balancer) onun IP-lərini bura yaz.
    // BOŞ buraxılsa yalnız loopback-ə (eyni serverdəki Nginx/IIS) etibar edilir — bu təhlükəsiz defaultdur.
    // ⚠️ Səhv doldurulsa hücumçu X-Forwarded-For saxtalaşdırıb rate limiting-i tamamilə keçə bilər.
    "KnownProxies": []
  },

  // Data Protection açarları (e-poçt təsdiq/şifrə sıfırlama tokenləri, Google correlation cookie).
  // DB kimi bu qovluq da publish qovluğundan KƏNARDA olmalıdır — redeploy zamanı silinsə
  // göndərilmiş bütün linklər etibarsız olur. Serverdə: DataProtection__KeysPath=/var/kiberaz/keys
  "DataProtection": {
    "KeysPath": "./App_Data/keys"
  },

  "FrontendUrl": "https://kiberaz.az",

  // HostFiltering middleware Host başlığını bu siyahı ilə tutuşdurur.
  // API ayrıca alt-domendə (api.kiberaz.az) işləyir — o burada OLMASA hər sorğu 400 "Invalid Host" alır.
  // Nginx-də `proxy_set_header Host $host;` verilməlidir ki, tətbiq real host adını görsün.
  "AllowedHosts": "kiberaz.az;www.kiberaz.az;api.kiberaz.az",

  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "465",
    "FromEmail": "noreply@kiberaz.az",
    "FromName": "Kiberaz.az"
    // SmtpUsername / SmtpPassword → environment variable
  },

  "Captcha": {
    // ⚠️ Captcha:SecretKey BURADA OLMAMALIDIR — environment variable ilə verilir:
    //      Captcha__SecretKey=0x...
    //    Cloudflare paneli → Turnstile → widget → "Secret Key".
    //
    // Tətbiq production-da aşağıdakı hallarda QALXMIR (CaptchaService.EnsureProductionReady):
    //    • Captcha:SecretKey boşdursa;
    //    • Cloudflare-in test açarı ("1x…AA", "2x…AA", "3x…AA") verilibsə —
    //      bu açarlar hər tokeni qeyd-şərtsiz qəbul edir, yəni CAPTCHA sönmüş olur;
    //    • Captcha:AllowDevelopmentBypass true-dursa.
    //
    // AllowedHostnames: Cloudflare token-in yaradıldığı domeni qaytarır və burada
    // gözlənilən domenlərlə tutuşdurulur. Panel siyahısı səhvən genişləndirilsə belə,
    // başqa saytda toplanmış token bu server tərəfindən qəbul edilmir.
    // Boş buraxılsa yoxlama aparılmır.
    "AllowedHostnames": [ "kiberaz.az", "www.kiberaz.az" ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Kiberaz": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
