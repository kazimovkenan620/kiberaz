{
  "ConnectionStrings": {
    // LiteDB — embedded NoSQL verilənlər bazası (tək .db faylı)
    // Filename: .db faylının yolu (lahiyə kökündən nisbi)
    // Connection=shared: birdən çox thread eyni anda oxuya bilər
    "LiteDb": "Filename=../Kiberaz.Infrastructure/Data/Kiberaz.db;Connection=shared"
  },
  "JwtSettings": {
    "Issuer": "kiberaz.az",
    "Audience": "kiberaz-users"
    // QEYD: SecretKey buraya YAZILMIR!
    // dotnet user-secrets set "JwtSettings:SecretKey" "your-super-secret-key-here" əmri ilə saxlanır
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "kiberaz.az;www.kiberaz.az;localhost",
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "465",
    "FromEmail": "noreply@kiberaz.az",
    "FromName": "Kiberaz.az",
    "SmtpUsername": "your_email_here",
    "SmtpPassword": "your_password_here",
    "ApiBaseUrl": "http://localhost:5251"
  }
}
