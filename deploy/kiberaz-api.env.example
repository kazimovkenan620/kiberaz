# /etc/kiberaz/api.env — systemd EnvironmentFile (chmod 640, root:kiberaz)
# ASP.NET Core iç-içə açarları "__" ilə oxuyur. Bu fayl REPO-YA DÜŞMƏMƏLİDİR.
# Tətbiq boş/səhv dəyərdə start-da dayanır (JWT, CAPTCHA, DataProtection) — bu, qəsdəndir.

# ── Zəruri (🔴 olmasa tətbiq qalxmır və ya əsas axın sınır) ─────────────────
# openssl rand -base64 64   (≥ 32 bayt; "SuperSecretKeyForDevelopment…" ilə başlaya bilməz)
JwtSettings__SecretKey=CHANGE_ME_openssl_rand_base64_64

# Publish qovluğundan KƏNAR yol — redeploy silməsin. Qovluğa kiberaz istifadəçisinin yazma icazəsi olmalıdır.
ConnectionStrings__LiteDb=Filename=/var/kiberaz/data/Kiberaz.db;Connection=shared
DataProtection__KeysPath=/var/kiberaz/keys

# E-poçt linkləri bu ünvandan qurulur
FrontendUrl=https://kiberaz.az

# SMTP provider panelində təsdiqlənmiş sender/domain istifadə edin.
# Hetzner-də 465 default bağlıdır; 587 STARTTLS tətbiq tərəfindən dəstəklənir.
EmailSettings__SmtpHost=smtp.PROVIDER.example
EmailSettings__SmtpPort=587
EmailSettings__FromEmail=noreply@kiberaz.az
EmailSettings__FromName=Kiberaz.az
EmailSettings__SmtpUsername=noreply@kiberaz.az
EmailSettings__SmtpPassword=CHANGE_ME_provider_smtp_password

# Cloudflare Turnstile → widget → Secret Key. Test açarı (1x/2x/3x…AA) ilə tətbiq qalxmır.
Captcha__SecretKey=CHANGE_ME_turnstile_secret

# ── Tövsiyə olunan ────────────────────────────────────────────────────────────
# Google girişi (yoxdursa sadəcə söndürülür). Redirect URI: https://api.kiberaz.az/signin-google
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# Yükləmə kvotası — real diskə görə (bayt). MinFreeBytes: bu qədər boş yer qalmayanda yükləmə dayanır.
Uploads__MaxTotalBytes=2147483648
Uploads__MaxFiles=4000
Uploads__MinFreeBytes=2147483648

# ── YALNIZ proxy ayrı maşındadırsa (Cloudflare proxy, xarici LB) ─────────────
# Eyni serverdəki nginx üçün BOŞ QALSIN — loopback default etibarlıdır.
# ForwardedHeaders__KnownProxies__0=

# ── HEÇ VAXT production-da ────────────────────────────────────────────────────
# Captcha__AllowDevelopmentBypass=true
# ASPNETCORE_ENVIRONMENT=Development
