{
  // ─────────────────────────────────────────────────────────────
  // PRODUCTION KONFİQURASİYASI
  // Bu fayl repo-ya commit olunur — burada HEÇ BİR GİZLİ AÇAR OLMAMALIDIR.
  // Secret-lər environment variable ilə verilir (iç-içə açarlar üçün "__"):
  //   JwtSettings__SecretKey, Captcha__SecretKey,
  //   EmailSettings__SmtpUsername, EmailSettings__SmtpPassword,
  //   Authentication__Google__ClientId, Authentication__Google__ClientSecret
  // ─────────────────────────────────────────────────────────────

  "ConnectionStrings": {
    // Publish çıxışı düz strukturdur — development-dəki "../Kiberaz.Infrastructure/Data/..."
    // yolu serverdə MÖVCUD DEYİL. Baza tətbiqin yanındakı App_Data qovluğunda saxlanılır.
    //
    // ⚠️ App_Data qovluğu publish qovluğunun İÇİNDƏ olmamalıdır — redeploy zamanı silinər.
    // Serverdə mütləq qovluqdan kənara yönləndir (env var ilə), məsələn:
    //   ConnectionStrings__LiteDb="Filename=/var/kiberaz/data/Kiberaz.db;Connection=shared"
    "LiteDb": "Filename=./App_Data/Kiberaz.db;Connection=shared"
  },

  "ForwardedHeaders": {
    // Proxy AYRI maşındadırsa (Cloudflare, xarici load balancer) onun IP-lərini bura yaz.
    // BOŞ buraxılsa yalnız loopback-ə (eyni serverdəki Nginx/IIS) etibar edilir — bu təhlükəsiz defaultdur.
    // ⚠️ Səhv doldurulsa hücumçu X-Forwarded-For saxtalaşdırıb rate limiting-i tamamilə keçə bilər.
    "KnownProxies": []
  },

  "FrontendUrl": "https://kiberaz.az",

  "AllowedHosts": "kiberaz.az;www.kiberaz.az",

  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "465",
    "FromEmail": "noreply@kiberaz.az",
    "FromName": "Kiberaz.az"
    // SmtpUsername / SmtpPassword → environment variable
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Kiberaz": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
